/bin/bash -lc 'mkdir -p /app/ssl && openssl req -x509 -newkey rsa:2048 -keyout /app/ssl/server.key -out /app/ssl/server.crt -days 365 -nodes -subj "/O=DevOps Team/CN=dev-internal.company.local" && chmod 600 /app/ssl/server.key && cat /app/ssl/server.key /app/ssl/server.crt > /app/ssl/server.pem && chmod 600 /app/ssl/server.pem && { openssl x509 -in /app/ssl/server.crt -noout -subject; openssl x509 -in /app/ssl/server.crt -noout -dates; openssl x509 -in /app/ssl/server.crt -noout -fingerprint -sha256; } > /app/ssl/verification.txt' in /app
