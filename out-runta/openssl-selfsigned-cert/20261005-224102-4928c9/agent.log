diff --git a/check_cert.py b/check_cert.py
new file mode 100644
index 0000000000000000000000000000000000000000..90e85f685b605824f34560a8a8a7d5d141ee28a4
--- /dev/null
+++ b/check_cert.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import datetime as dt
+import ssl
+import sys
+from pathlib import Path
+
+
+CERT_PATH = Path("/app/ssl/server.crt")
+
+
+def main() -> int:
+    if not CERT_PATH.exists():
+        print(f"Certificate not found: {CERT_PATH}", file=sys.stderr)
+        return 1
+
+    try:
+        cert = ssl._ssl._test_decode_cert(str(CERT_PATH))
+    except Exception as exc:
+        print(f"Unable to load certificate: {exc}", file=sys.stderr)
+        return 1
+
+    subject_parts = {
+        key: value
+        for group in cert.get("subject", ())
+        for key, value in group
+    }
+    common_name = subject_parts.get("commonName")
+    if not common_name:
+        print("Certificate does not contain a Common Name", file=sys.stderr)
+        return 1
+
+    not_after = cert.get("notAfter")
+    if not not_after:
+        print("Certificate does not contain an expiration date", file=sys.stderr)
+        return 1
+
+    expires = dt.datetime.strptime(not_after, "%b %d %H:%M:%S %Y %Z")
+
+    print(f"Common Name: {common_name}")
+    print(f"Expiration Date: {expires:%Y-%m-%d}")
+    print("Certificate verification successful")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

